{#- Central enterprise edition template (constitution Principle IX, FR-015/FR-016).
    Mandatory structure: masthead -> TL;DR -> stories -> action items -> references.
    Brand tokens are injected from config/brand.yaml; never hard-code identity here. -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brand.newsletter_title }} — Edition #{{ edition.number }} ({{ edition.month }})</title>
<style>
  :root {
    --color-primary: {{ brand.palette.get('primary', '#1F3A5F') }};
    --color-accent: {{ brand.palette.get('accent', '#E07B39') }};
    --color-text: {{ brand.palette.get('text', '#1A1A1A') }};
    --font-heading: "{{ brand.typography.get('heading', 'Segoe UI') }}", "Segoe UI", Arial, sans-serif;
    --font-body: "{{ brand.typography.get('body', 'Georgia') }}", Georgia, serif;
  }
  * { box-sizing: border-box; }
  body {
    font-family: var(--font-body); color: var(--color-text);
    max-width: 54rem; margin: 0 auto; padding: 0 1.5rem 3rem; line-height: 1.65;
  }
  h1, h2, h3, figcaption, .masthead, .classification-banner { font-family: var(--font-heading); }
  a { color: var(--color-primary); }

  .classification-banner {
    background: var(--color-primary); color: #fff; text-align: center;
    text-transform: uppercase; letter-spacing: .15em; font-size: .75rem;
    padding: .35rem 1rem; margin: 0 -1.5rem;
  }
  .masthead {
    display: flex; align-items: center; gap: 1.25rem;
    border-bottom: 4px solid var(--color-accent); padding: 1.5rem 0 1rem; margin-bottom: 1rem;
  }
  .masthead .logo img { max-height: 64px; }
  .masthead .logo-placeholder {
    width: 64px; height: 64px; border: 2px dashed var(--color-accent); border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    color: var(--color-accent); font-size: 1.6rem; font-weight: 700;
  }
  .masthead h1 { margin: 0; font-size: 1.9rem; color: var(--color-primary); }
  .masthead .edition-line { margin: .2rem 0 0; color: #555; font-size: .95rem; }

  section { margin: 2rem 0; }
  section > h2 {
    color: var(--color-primary); border-bottom: 1px solid #ddd;
    padding-bottom: .3rem; font-size: 1.4rem;
  }
  section[data-kind="tldr"] {
    background: color-mix(in srgb, var(--color-primary) 6%, white);
    border-left: 4px solid var(--color-primary); padding: .75rem 1.25rem; border-radius: 4px;
  }
  section[data-kind="tldr"] > h2 { border-bottom: none; margin-top: .25rem; }

  figure { margin: 1.75rem auto; text-align: center; max-width: 100%; }
  figure svg { max-width: 100%; height: auto; }
  figcaption { font-size: .9rem; color: #555; margin-top: .5rem; }

  sup.citation { color: var(--color-accent); font-size: .75em; }
  code {
    font-family: Consolas, "Courier New", monospace; font-size: .9em;
    background: #f4f4f4; padding: .1rem .35rem; border-radius: 3px;
  }
  .callout {
    border-left: 4px solid var(--color-accent); background: #fdf6f0;
    padding: .75rem 1.25rem; margin: 1.25rem 0; border-radius: 4px;
  }
  section[data-kind="references"] { font-size: .9rem; color: #444; }
  section[data-kind="references"] li { margin-bottom: .35rem; }

  footer {
    margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #ddd;
    font-size: .8rem; color: #777;
  }

  /* Print stylesheet (FR-026): same template, print-faithful rendering */
  @media print {
{% include "print.css" %}
  }
</style>
</head>
<body>
<div class="classification-banner" role="note" aria-label="Document classification">
  {{ edition.classification_label }}
</div>

<header class="masthead">
  <div class="logo">
    {%- if brand.logo_path %}
    <img src="{{ brand.logo_path }}" alt="{{ brand.newsletter_title }} logo">
    {%- else %}
    <div class="logo-placeholder" title="Brand logo pending">{{ brand.newsletter_title[:1] }}</div>
    {%- endif %}
  </div>
  <div>
    <h1>{{ brand.newsletter_title }}</h1>
    <p class="edition-line">Edition #{{ edition.number }} — {{ edition.month }}</p>
  </div>
</header>

<main>
{%- for section in sections %}
<section data-kind="{{ section.kind }}">
  <h2>{{ section.title }}</h2>
  {{ section.body_html }}
  {%- for diagram in section.diagrams %}
  <figure role="img" aria-label="{{ diagram.alt_text }}">
    {{ diagram.svg }}
    <figcaption>{{ diagram.caption }}</figcaption>
  </figure>
  {%- endfor %}
</section>
{%- endfor %}
</main>

<footer>
  <p>{{ brand.newsletter_title }} — Edition #{{ edition.number }} ({{ edition.month }}).
     Classification: {{ edition.classification_label }}. Template {{ template_version }}.</p>
</footer>
</body>
</html>
