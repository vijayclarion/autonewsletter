# Copy to .env and fill in. Secrets live only in the environment, never in config files.
# Provider/model selection is configuration: set LLM_PROVIDER and LLM_MODEL, then supply
# the matching API key. Only the key for the selected provider is required.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
